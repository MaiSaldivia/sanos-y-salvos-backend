{
  "info": {
    "name": "Sanos y Salvos - API",
    "description": "Coleccion de endpoints del sistema Sanos y Salvos. Los health checks se hacen directo a cada microservicio. El resto de endpoints usa el BFF en el puerto 3005. Ejecutar Login primero para guardar el token JWT automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3005/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "mascota_id",
      "value": "msc-001",
      "type": "string"
    },
    {
      "key": "usuario_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Health - ms-usuarios-entidades",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3004/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3004",
              "path": ["health"]
            },
            "description": "Verifica que ms-usuarios-entidades este corriendo en el puerto 3004. Respuesta esperada: { status: OK }."
          }
        },
        {
          "name": "Health - ms-gestion-mascotas (via BFF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3005/api/mascotas/estadisticas",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3005",
              "path": ["api", "mascotas", "estadisticas"]
            },
            "description": "Verifica que el BFF llega a ms-gestion-mascotas. Si responde 200 con totales, ambos estan corriendo."
          }
        },
        {
          "name": "Health - ms-geolocalizacion (via BFF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3005/api/geolocalizacion/estadisticas",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3005",
              "path": ["api", "geolocalizacion", "estadisticas"]
            },
            "description": "Verifica que el BFF llega a ms-geolocalizacion. Si responde 200, ambos estan corriendo."
          }
        },
        {
          "name": "Health - ms-motor-coincidencias (via BFF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3005/api/motor/resumen",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3005",
              "path": ["api", "motor", "resumen"]
            },
            "description": "Verifica que el BFF llega a ms-motor-coincidencias. Si responde 200, ambos estan corriendo."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "var payload = res.data ? res.data : res;",
                  "if (payload && payload.token) {",
                  "    pm.collectionVariables.set('token', payload.token);",
                  "    pm.collectionVariables.set('usuario_id', payload.usuario ? payload.usuario.idUsuario : '');",
                  "}",
                  "pm.test('Login exitoso', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sanosysalvos.cl\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Inicia sesion con el usuario administrador. El token JWT se guarda automaticamente en la variable de coleccion."
          }
        },
        {
          "name": "Login - dueno",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "var payload = res.data ? res.data : res;",
                  "if (payload && payload.token) {",
                  "    pm.collectionVariables.set('token', payload.token);",
                  "    pm.collectionVariables.set('usuario_id', payload.usuario ? payload.usuario.idUsuario : '');",
                  "}",
                  "pm.test('Login exitoso', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dueno@demo.cl\",\n  \"password\": \"dueno123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login con usuario de rol DUENO."
          }
        },
        {
          "name": "Login - refugio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "var payload = res.data ? res.data : res;",
                  "if (payload && payload.token) {",
                  "    pm.collectionVariables.set('token', payload.token);",
                  "}",
                  "pm.test('Login exitoso', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"refugio@esperanza.cl\",\n  \"password\": \"refugio123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login con usuario de rol REFUGIO (moderador)."
          }
        },
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Maria Gonzalez\",\n  \"email\": \"maria@test.cl\",\n  \"password\": \"segura123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Registra una nueva cuenta. El rol queda como DUENO por defecto. Retorna 409 si el email ya existe."
          }
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Retorna los datos del usuario autenticado segun el token JWT."
          }
        },
        {
          "name": "Actualizar nombre",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Maria A. Gonzalez\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Actualiza el nombre del usuario autenticado. Minimo 2 caracteres, maximo 120."
          }
        },
        {
          "name": "Cambiar contrasena",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password_actual\": \"dueno123\",\n  \"password_nuevo\": \"nueva456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/me/password",
              "host": ["{{base_url}}"],
              "path": ["auth", "me", "password"]
            },
            "description": "Cambia la contrasena. La nueva debe ser diferente a la actual y tener minimo 6 caracteres."
          }
        },
        {
          "name": "Listar usuarios (admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/usuarios",
              "host": ["{{base_url}}"],
              "path": ["auth", "usuarios"]
            },
            "description": "Lista todos los usuarios. Requiere rol ADMIN. Hacer Login admin primero."
          }
        },
        {
          "name": "Estadisticas de usuarios (admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/usuarios/estadisticas",
              "host": ["{{base_url}}"],
              "path": ["auth", "usuarios", "estadisticas"]
            },
            "description": "Conteo de usuarios por rol. Requiere rol ADMIN."
          }
        },
        {
          "name": "Cambiar rol (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rol\": \"REFUGIO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/usuarios/{{usuario_id}}/rol",
              "host": ["{{base_url}}"],
              "path": ["auth", "usuarios", "{{usuario_id}}", "rol"]
            },
            "description": "Cambia el rol de un usuario. Requiere rol ADMIN. Valores: DUENO, VETERINARIA, REFUGIO, MUNICIPALIDAD, ADMIN."
          }
        },
        {
          "name": "Toggle activo (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{base_url}}/auth/usuarios/{{usuario_id}}/toggle-activo",
              "host": ["{{base_url}}"],
              "path": ["auth", "usuarios", "{{usuario_id}}", "toggle-activo"]
            },
            "description": "Activa o desactiva la cuenta de un usuario. Requiere rol ADMIN."
          }
        }
      ]
    },
    {
      "name": "Mascotas",
      "item": [
        {
          "name": "Listar todas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/mascotas",
              "host": ["{{base_url}}"],
              "path": ["mascotas"]
            },
            "description": "Retorna todas las mascotas sin filtros."
          }
        },
        {
          "name": "Buscar con filtros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/mascotas/busqueda?estado=PERDIDA&tipo_animal=Perro",
              "host": ["{{base_url}}"],
              "path": ["mascotas", "busqueda"],
              "query": [
                { "key": "estado", "value": "PERDIDA", "description": "PERDIDA, ENCONTRADA o REUNIFICADA" },
                { "key": "tipo_animal", "value": "Perro" },
                { "key": "tamano", "value": "", "disabled": true, "description": "Pequeño, Mediano o Grande" },
                { "key": "raza", "value": "", "disabled": true }
              ]
            },
            "description": "Busqueda con filtros opcionales. Dejar en blanco los que no se necesiten."
          }
        },
        {
          "name": "Obtener por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/mascotas/{{mascota_id}}",
              "host": ["{{base_url}}"],
              "path": ["mascotas", "{{mascota_id}}"]
            },
            "description": "Detalle completo de una mascota. La variable mascota_id viene del seed o se guarda al crear una."
          }
        },
        {
          "name": "Estadisticas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/mascotas/estadisticas",
              "host": ["{{base_url}}"],
              "path": ["mascotas", "estadisticas"]
            },
            "description": "Totales por estado: perdidas, encontradas, reunificadas."
          }
        },
        {
          "name": "Mis reportes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/mascotas/usuario/mis-reportes",
              "host": ["{{base_url}}"],
              "path": ["mascotas", "usuario", "mis-reportes"]
            },
            "description": "Mascotas del usuario autenticado. Requiere token."
          }
        },
        {
          "name": "Reportar mascota",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res && res.idMascota) {",
                  "    pm.collectionVariables.set('mascota_id', res.idMascota);",
                  "}",
                  "pm.test('Mascota creada', function() {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoAnimal\": \"Perro\",\n  \"nombre\": \"Coco\",\n  \"raza\": \"Mestizo\",\n  \"colorPrimario\": \"Cafe\",\n  \"tamano\": \"Mediano\",\n  \"sexo\": \"Macho\",\n  \"edad\": \"3 anos\",\n  \"estado\": \"PERDIDA\",\n  \"sector\": \"Centro\",\n  \"comuna\": \"Concepcion\",\n  \"direccion\": \"Barros Arana 450\",\n  \"contacto\": \"dueno@demo.cl\",\n  \"latitud\": -36.8201,\n  \"longitud\": -73.0444,\n  \"descripcion\": \"Collar rojo, muy amigable\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/mascotas/reportar",
              "host": ["{{base_url}}"],
              "path": ["mascotas", "reportar"]
            },
            "description": "Registra una nueva mascota. Requiere token. El ID creado se guarda en mascota_id automaticamente."
          }
        },
        {
          "name": "Actualizar mascota",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoAnimal\": \"Perro\",\n  \"nombre\": \"Coco\",\n  \"raza\": \"Mestizo\",\n  \"colorPrimario\": \"Cafe\",\n  \"tamano\": \"Mediano\",\n  \"estado\": \"ENCONTRADA\",\n  \"sector\": \"Centro\",\n  \"comuna\": \"Concepcion\",\n  \"direccion\": \"Barros Arana 450\",\n  \"contacto\": \"dueno@demo.cl\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/mascotas/{{mascota_id}}",
              "host": ["{{base_url}}"],
              "path": ["mascotas", "{{mascota_id}}"]
            },
            "description": "Actualiza una mascota. Solo el dueno o moderador puede editar."
          }
        },
        {
          "name": "Eliminar mascota",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/mascotas/{{mascota_id}}",
              "host": ["{{base_url}}"],
              "path": ["mascotas", "{{mascota_id}}"]
            },
            "description": "Elimina una mascota. Solo el dueno o moderador puede eliminar."
          }
        },
        {
          "name": "Reportar encuentro",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"encontrada_en\": \"Parque Ecuador, Concepcion\",\n  \"contacto_nombre\": \"Juan Perez\",\n  \"contacto_telefono\": \"+56912345678\",\n  \"foto_evidencia_url\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/mascotas/{{mascota_id}}/reportar-encuentro",
              "host": ["{{base_url}}"],
              "path": ["mascotas", "{{mascota_id}}", "reportar-encuentro"]
            },
            "description": "Reporta que encontro una mascota perdida. Queda EN_REVISION hasta que un moderador la revise."
          }
        },
        {
          "name": "Encuentros en revision",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/mascotas/encuentros/revision",
              "host": ["{{base_url}}"],
              "path": ["mascotas", "encuentros", "revision"]
            },
            "description": "Lista todos los reportes de encuentro pendientes de revision."
          }
        },
        {
          "name": "Revisar encuentro",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accion\": \"APROBAR\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/mascotas/encuentros/revision/REPORTE_ID_AQUI",
              "host": ["{{base_url}}"],
              "path": ["mascotas", "encuentros", "revision", "REPORTE_ID_AQUI"]
            },
            "description": "Aprueba o rechaza un encuentro. Valores: APROBAR o RECHAZAR. Al aprobar la mascota pasa a REUNIFICADA. Reemplazar REPORTE_ID_AQUI con el id del reporte obtenido en Encuentros en revision."
          }
        }
      ]
    },
    {
      "name": "Motor de Coincidencias",
